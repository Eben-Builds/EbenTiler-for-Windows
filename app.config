<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    EbenTiler lays out its WinForms UI with explicit DPI-scaled coordinates.
    Keep PerMonitorV2 awareness, but do not let .NET Framework resize the same
    controls a second time when Windows display scaling changes at runtime.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
